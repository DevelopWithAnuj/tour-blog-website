# Copy this file to backend/.env and replace all placeholder credentials.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/drimora
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-token-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=replace-with-mailtrap-username
MAILTRAP_SMTP_PASS=replace-with-mailtrap-password
MAIL_FROM="Drimora Travel <no-reply@drimora.com>"

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Optional booking policy overrides.
CANCELLATION_WINDOW_HOURS=24
CANCELLATION_MIN_HOURS_BEFORE_TRAVEL=48
